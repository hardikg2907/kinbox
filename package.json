{
  "name": "kinbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "user:create": "tsx --conditions=react-server scripts/user-create.ts",
    "db:migrate:deploy": "tsx --conditions=react-server scripts/migrate-on-deploy.ts",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.10",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.x"
  },
  "simple-git-hooks": {
    "pre-commit": "if [ -f scripts/hooks/pre-commit.ts ]; then pnpm exec tsx scripts/hooks/pre-commit.ts; else echo '[hooks] This branch has no hook scripts yet; skipping.'; fi",
    "pre-push": "if [ -f scripts/hooks/pre-push.sh ]; then sh scripts/hooks/pre-push.sh; else echo '[hooks] This branch has no hook scripts yet; skipping.'; fi",
    "preserveUnused": [
      "post-checkout"
    ]
  }
}
