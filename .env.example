# Names only. Local values go in .env.development.local (database, auth) and
# .env.local (TMDB token). Vercel holds production values.

# Neon pooled URL for the app; the direct URL is used for migrations when set.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# 32+ random characters, e.g. `openssl rand -base64 32`. The site's own URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# TMDB API Read Access Token. Never give it a NEXT_PUBLIC_ prefix.
TMDB_API_READ_TOKEN=
# 1 uses the bundled TMDB fixtures instead of the network (development and tests only).
TMDB_FAKE=

# Tests only, in .env.test.local (Vitest runs with NODE_ENV=test, which loads that file):
# the database the tests wipe, plus any 32+ character BETTER_AUTH_SECRET and a BETTER_AUTH_URL.
TEST_DATABASE_URL=
